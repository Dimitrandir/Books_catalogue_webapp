# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/family_library

# Cloudflare R2 (S3-compatible storage за корици на книги)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
AWS_S3_REGION_NAME=auto

# Anthropic API (АИ разпознаване на корица)
ANTHROPIC_API_KEY=

# Open Library / Google Books нямат нужда от ключ за базовите заявки,
# но ако решим да минем на Google Books API по-късно за по-добри резултати,
# ключът ще влезе тук:
# GOOGLE_BOOKS_API_KEY=
